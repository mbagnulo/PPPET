import "./stdlib/hashes/pedersen/512bit" as pedersen;
import "./stdlib/hashes/utils/256bitsDirectionHelper" as multiplex;

const u32 DEPTH = 2;

def main(private u32[16] kp_hs_id, u32[8] root, private bool[DEPTH] directionSelector, private u32[DEPTH][8] path){
    // Hashes kp_hs_id. If kp_hs_id is allowed by the HDir, the resulting hash will be a leaf of the tree
    u32[8] mut digest = pedersen(kp_hs_id);

    // Loop up the tree
    for u32 i in 0..DEPTH {
        u32[16] preimage = multiplex(directionSelector[i], digest, path[i]);
        digest = pedersen(preimage);
    }
    assert(digest == root);
}
